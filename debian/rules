#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -Denable_valadoc=false -Dgi-docgen=false

override_dh_makeshlibs:
	dh_makeshlibs -- -c1

override_dh_missing:
	dh_missing --fail-missing --list-missing

