# Lintian is really bad at associating manpages
systemd-boot: spare-manual-page
# Manpages are autogenerated from DocBook, these warnings are useless
systemd-boot: groff-message * [usr/share/man/*]
# Needed as a workaround for dpkg bug w.r.t. usrmerge
systemd-boot: conflicts-with-version systemd (<< 256-2~)
systemd-boot: conflicts-with-version systemd-boot-efi (<< 256-2~)
