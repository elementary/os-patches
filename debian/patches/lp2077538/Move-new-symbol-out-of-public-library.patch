 src/libsystemd/sd-login/sd-login.c | 30 -------------------
 src/systemd/sd-login.h             |  5 ----
 src/udev/udev-builtin-uaccess.c    | 60 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 60 insertions(+), 36 deletions(-)

